# ==============================================================================
# Environment Configuration Template (.env.example)
# E-commerce Django & AI Analytics Platform
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit .env or any secret keys to version control.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=your-django-secret-key-here-must-be-at-least-32-chars-long
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.onrender.com

# --- Database Connection (PostgreSQL / SQLite) ---
# For local development with SQLite, leave blank or specify postgres connection string:
# DATABASE_URL=postgresql://db_user:db_password@db_host:5432/db_name?sslmode=require
DATABASE_URL=

# --- Internal Microservice Secret (AI Agent Gateway <-> Django API) ---
INTERNAL_API_SECRET=your-shared-internal-secret-token-min-32-chars-hex

# --- Staff JWT Signing/Verification (falls back to DJANGO_SECRET_KEY if unset in
# local/testing, but REQUIRED in production -- config/settings/production.py fails
# to boot without it) ---
JWT_SECRET_KEY=your-jwt-signing-secret-distinct-from-django-secret-key

# --- Chatbot Read-Only DB Role (Neon) ---
# Dedicated least-privilege Postgres connection string for the SQL sandbox
# (apps/core/services/sql_sandbox_service.py), using the role provisioned by
# docs/sql/create_chatbot_readonly_role.sql. REQUIRED in production -- without
# it config/settings/production.py fails to boot. Not needed for local dev or
# tests (both run on SQLite and fall back to the default connection).
CHATBOT_READONLY_DATABASE_URL=postgresql://chatbot_readonly_role:password@host:5432/neondb?sslmode=require

# --- Cloudinary Asset Storage (persistent media backend) ---
# REQUIRED in production -- config/settings/production.py fails to boot without
# all three (Render's disk is ephemeral; without Cloudinary, uploaded product/
# profile images are lost on every redeploy). Not needed for local dev or tests
# (both fall back to FileSystemStorage on SQLite).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- AI Agent Gateway Microservice ---
AI_AGENT_GATEWAY_URL=https://ai-agent-gateway-sued.onrender.com
